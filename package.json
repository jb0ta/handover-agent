{
  "name": "handover-agent",
  "version": "0.2.0",
  "description": "A client-side handover agent implementing skill-as-code, scoped vault handover, and micro-engagement workflow",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "gate": "ts-node src/server/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "validate:schemas": "node scripts/validate-schemas.js",
    "browser:build": "ts-node scripts/build-browser.ts",
    "demo:build": "ts-node scripts/build-demo.ts"
  },
  "keywords": [
    "agents",
    "agentic-workflows",
    "micro-engagements",
    "handover",
    "skills-as-code",
    "scoped-handover",
    "vault",
    "provenance",
    "freelancing"
  ],
  "author": "José Bota <josebota@gmail.com>",
  "license": "CC-BY-4.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "name": "handover-agent",
  "version": "0.1.1",
  "description": "A client-side handover agent implementing skill-as-code, scoped vault handover, and micro-engagement workflow",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "validate:schemas": "node scripts/validate-schemas.js"
  },
  "keywords": [
    "agents",
    "agentic-workflows",
    "micro-engagements",
    "handover",
    "skills-as-code",
    "scoped-handover",
    "vault",
    "provenance",
    "freelancing"
  ],
  "author": "José Bota <josebota@gmail.com>",
  "license": "CC-BY-4.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
